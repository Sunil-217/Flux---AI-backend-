# Copy this file to `.env` and fill in real values.

# ── App mode ── set to "production" to enable strict startup checks
# (refuses to boot with default JWT_SECRET / localhost CORS / missing keys).
APP_ENV=development

# ── Groq (chat, routing, planning, code, vision, transcription) — required ──
# Every LLM call runs here. Free signup: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# ── Embeddings for document Q&A (RAG) — required for PDF upload ──
# Jina is preferred: 1024-dim, ~89 languages, free tier, no credit card.
# https://jina.ai/embeddings/  — if unset, falls back to the NVIDIA key below.
JINA_API_KEY=your-jina-api-key

# ── NVIDIA NIM — optional SECOND LLM provider, and the legacy embeddings
#    fallback (embeddings use it only when JINA_API_KEY is unset). ──
# Free key: https://build.nvidia.com  → "Get API Key" (an `nvapi-...` string).
# A key can list the catalog while having NO inference entitlement — that state
# answers 200 on GET /v1/models and 403 on every chat/embeddings call. If chat
# via NVIDIA returns "credentials rejected", check entitlement/credits on the
# NVIDIA account rather than the key format. Groq keeps serving either way.
NVIDIA_API_KEY=your-nvidia-api-key

# ── Model ids — all optional, all overridable without a code change ──
# Groq (primary). Defaults shown; unset means the default.
# MODEL=openai/gpt-oss-120b
# PLAN_MODEL=openai/gpt-oss-120b
# CODE_MODEL=openai/gpt-oss-120b
# VISION_MODEL=qwen/qwen3.8-27b
# ROUTER_MODEL=qwen/qwen3.8-27b
# FALLBACK_CHAT_MODEL=qwen/qwen3.8-27b
#
# NVIDIA. The default is a mixture-of-experts Nemotron chosen for agentic
# reasoning (≈12B active of 120B total: large-model quality, not large-model
# latency). Do NOT set meta/llama-3.3-70b-instruct — NVIDIA retired it
# (410, EOL 2026-08-26) and it is absent from the live catalog.
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_PLAN_MODEL=   (defaults to NVIDIA_MODEL)
# NVIDIA_CODE_MODEL=   (defaults to NVIDIA_MODEL)

# ── Which provider serves which role: groq | nvidia | auto ──
# "auto" prefers NVIDIA when NVIDIA_API_KEY is set, else Groq. Every role keeps
# a fallback chain, so an outage on one provider degrades instead of failing.
# The hot path stays on Groq (measurably faster); only the deliberative roles
# default to NVIDIA, which is what the extra latency buys something for.
# CHAT_PROVIDER=groq
# ROUTER_PROVIDER=groq
# CODE_PROVIDER=groq
# VISION_PROVIDER=groq
# PLANNER_PROVIDER=auto
# ORCHESTRATOR_PROVIDER=auto

# ── Autonomous orchestration (POST /agent/task) ──
# Bounds on the agent loop. These make runaway behaviour impossible rather than
# unlikely — without them an unsatisfiable critic retries forever.
# AGENT_ORCHESTRATION_ENABLED=true
# MAX_AGENT_RETRIES=2
# MAX_PLAN_STEPS=8
# MAX_PARALLEL_STEPS=4
# AGENT_STEP_TIMEOUT=90

# ── Tavily (live web search) — optional; web search is disabled if unset ──
TAVILY_API_KEY=your-tavily-api-key

# ── Pollinations.ai (used by /video slash command) — optional ──
# Without this, /video returns a friendly error pointing here.
# Free signup, no credit card: https://enter.pollinations.ai/
POLLINATIONS_API_KEY=your-pollinations-seed-key

# ── Email (SMTP) for OTP — e.g. Brevo. If unset, OTP codes print to the server console. ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key
SMTP_FROM=your-verified-sender@example.com

# ── Auth / security ──
# REQUIRED in production: a strong random 32+ character secret.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRE_MINUTES=10080
OTP_TTL_MINUTES=10

# ── CORS: comma-separated allowed frontend origins ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database (optional; defaults to local SQLite). For production use Postgres, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./flux_ai.db

# ── Fluxway PSP orchestration (optional) ──
# Set all three to drive the Payment Gateways "Add" picker from Fluxway's live
# PSP catalog and onboard a PSP at brand level. Leave unset for local-only mode.
#   FLUXWAY_BASE_URL      — API base incl. prefix, e.g. http://localhost:7111/fluxway/v2
#   FLUXWAY_SECRET_TOKEN  — a brand environment secret (X-SECRET-TOKEN); it is
#                           bound to one brand+environment, so onboarding is
#                           scoped there. Rotate via Fluxway's
#                           PUT /brands/{id}/environments/{eid}/rotate-secret.
#   FLUXWAY_PSP_FLOW_TYPE — the FlowType name whose targets are the PSP catalog.
FLUXWAY_BASE_URL=
FLUXWAY_SECRET_TOKEN=
FLUXWAY_PSP_FLOW_TYPE=PSP
